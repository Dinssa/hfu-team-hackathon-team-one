{% extends "layout.njk" %}

{% block main_content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ page.title }}</h1>
      {% for paragraph in page.paragraphs %}
        <p class="govuk-body">{{ paragraph }}</p>
      {% endfor %}
    </div>
  </div>
{% endblock %}
