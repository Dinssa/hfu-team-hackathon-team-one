{% extends "layout.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "moj/components/timeline/macro.njk" import mojTimeline %}
{% from "components/page-header.njk" import pageHeader %}
{% from "components/side-navigation.njk" import sideNavigation %}
{% from "components/status-tag.njk" import statusTag %}
{% from "components/record-tables.njk" import applicationsTable %}

{% block breadcrumbs %}
  {{ govukBreadcrumbs({ items: [
    { text: "Home", href: "/" },
    { text: "Cases", href: "/cases" },
    { text: "Case " + kase.id }
  ] }) }}
{% endblock %}

{% block main_content %}
  {{ pageHeader({ caption: "Case " + kase.id, title: kase.title, statusLabel: "Checks status", status: kase.checks_status }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-quarter">
      {% set base = "/cases/" + kase.id %}
      {{ sideNavigation({
        currentPath: currentPath,
        label: "Sections of this case",
        items: [
          { text: "Household (" + guests.length + ")", href: base + "/household" },
          { text: "Sponsor and accommodation", href: base + "/sponsor-and-accommodation" },
          { text: "Safeguarding checks", href: base + "/checks" },
          { text: "Applications (" + applications.length + ")", href: base + "/applications" },
          { text: "History", href: base + "/history" }
        ]
      }) }}
    </div>

    <div class="govuk-grid-column-three-quarters">
      {% if section == "household" %}
      <h2 class="govuk-heading-l" id="household">Household</h2>
      {% if youngest and youngest.age < 18 %}
        {{ govukWarningText({
          text: "Youngest guest is " + youngest.age + ". A child is on this case, so the DBS check must be an Enhanced DBS.",
          iconFallbackText: "Warning"
        }) }}
      {% elif youngest %}
        <p class="govuk-body">Youngest guest is {{ youngest.age }} ({{ youngest.guest.given_name }} {{ youngest.guest.family_name }}). No children on this case.</p>
      {% endif %}
      <table class="govuk-table">
        <caption class="govuk-table__caption govuk-table__caption--s">{{ guests.length }} {{ "person" if guests.length == 1 else "people" }} on this case</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Name</th>
            <th scope="col" class="govuk-table__header">Role</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Age</th>
            <th scope="col" class="govuk-table__header">Application</th>
            <th scope="col" class="govuk-table__header">Visa status</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for g in guests %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell"><a class="govuk-link" href="/guests/{{ g.id }}">{{ g.given_name }} {{ g.family_name }}</a></td>
              <td class="govuk-table__cell">{{ g.relationship or ("Lead applicant" if g.is_lead else "Family member") }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ g.age if g.age !== null else "Unknown" }}</td>
              <td class="govuk-table__cell app-nowrap"><a class="govuk-link" href="/applications/{{ g.application_id }}">{{ g.uan or ("Application " + g.application_id) }}</a></td>
              <td class="govuk-table__cell">{{ statusTag(g.visa_status) }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if section == "sponsor-and-accommodation" %}

      <h2 class="govuk-heading-l" id="sponsor-and-accommodation">Sponsor and accommodation</h2>
      {{ govukSummaryList({
        card: { title: { text: "Who is hosting, and where", headingLevel: 3 } },
        rows: [
          { key: { text: "Sponsor" }, value: { html: ('<a class="govuk-link" href="/sponsors/' + kase.sponsor_id + '">' + (kase.sponsor_given_name + " " + kase.sponsor_family_name) | e + '</a>') if kase.sponsor_id else "Not given" } },
          { key: { text: "Sponsor contact" }, value: { text: [kase.sponsor_email, kase.sponsor_telephone] | reject("equalto", null) | join(", ") or "Not given" } },
          { key: { text: "Accommodation" }, value: { html: ('<a class="govuk-link" href="/accommodations/' + kase.accommodation_id + '">' + (kase.accommodation_address + (", " + kase.accommodation_postcode if kase.accommodation_postcode and kase.accommodation_postcode not in kase.accommodation_address else "")) | e + '</a>') if kase.accommodation_id else "To be confirmed: guests are not staying at the sponsor's address" } },
          { key: { text: "Local authority" }, value: { text: kase.council or "No local authority named" } },
          { key: { text: "Case opened" }, value: { text: kase.created_at | date } }
        ]
      }) }}
      {% endif %}

      {% if section == "checks" %}

      <h2 class="govuk-heading-l" id="checks">Safeguarding checks</h2>
      <table class="govuk-table">
        <caption class="govuk-table__caption govuk-table__caption--s">Four checks the local authority runs before and after arrival</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Check</th>
            <th scope="col" class="govuk-table__header">Status</th>
            <th scope="col" class="govuk-table__header">Last updated</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for c in checks %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">{{ c.kind }}. {{ c.name }}{% if c.kind == 3 and youngest and youngest.age < 18 %} <strong class="govuk-tag govuk-tag--red">Enhanced DBS required</strong>{% endif %}</td>
              <td class="govuk-table__cell">{{ statusTag(c.status) }}</td>
              <td class="govuk-table__cell">{{ (c.updated_at | date) if c.updated_at else "Not yet updated" }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if section == "applications" %}

      <h2 class="govuk-heading-l" id="applications">Applications</h2>
      {{ applicationsTable(applications, "Applications grouped into this case") }}
      {% endif %}

      {% if section == "history" %}

      <h2 class="govuk-heading-l" id="history">History</h2>
      {% set items = [] %}
      {% for e in events %}
        {% set items = (items.push({
          label: { text: e.description },
          datetime: { timestamp: e.occurred_at },
          text: e.kind | replace("_", " ") | capitalize
        }), items) %}
      {% endfor %}
      {% if items.length %}
        {{ mojTimeline({ items: items, headingLevel: 3 }) }}
      {% else %}
        <p class="govuk-body">Nothing has happened on this case yet.</p>
      {% endif %}
      {% endif %}
    </div>
  </div>
{% endblock %}
