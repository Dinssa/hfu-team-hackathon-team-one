{% extends "layout.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "components/stat-tiles.njk" import statTiles %}

{% block main_content %}
  <h1 class="govuk-heading-xl">{{ serviceName }}</h1>

  <p class="govuk-body-l">Casework for guests arriving under the Homes for Ukraine scheme: applications, households, safeguarding checks and arrivals.</p>

  {{ statTiles([
    { count: counts.applications, label: "Applications", href: "/applications" },
    { count: counts.guests, label: "Guests", href: "/guests" },
    { count: counts.sponsors, label: "Sponsors", href: "/sponsors" },
    { count: counts.accommodations, label: "Accommodation", href: "/accommodations" }
  ]) }}

  <h2 class="govuk-heading-m">Incoming data</h2>

  <form method="post" action="/ingest/next">
    {% if ingest.next %}
      <p class="govuk-body">Next file to process: <strong>{{ ingest.next }}</strong> ({{ ingest.remaining }} remaining of {{ ingest.files.length }}).</p>
      {{ govukButton({ text: "Process next file" }) }}
    {% else %}
      <p class="govuk-body">All {{ ingest.files.length }} data files have been processed.</p>
    {% endif %}
  </form>

  {% if files.length %}
    {% set rows = [] %}
    {% for f in files %}
      {% set rows = (rows.push([
        { text: f.file_name },
        { text: f.file_type },
        { text: f.processed_at | date },
        { text: f.row_count, format: "numeric" },
        { text: f.created_count, format: "numeric" },
        { text: f.skipped_count, format: "numeric" },
        { text: f.rejected_count, format: "numeric" }
      ]), rows) %}
    {% endfor %}
    {{ govukTable({
      caption: "Files processed so far",
      captionClasses: "govuk-table__caption--s",
      head: [
        { text: "File" },
        { text: "Type" },
        { text: "Processed" },
        { text: "Rows", format: "numeric" },
        { text: "Created", format: "numeric" },
        { text: "Already present", format: "numeric" },
        { text: "Rejected", format: "numeric" }
      ],
      rows: rows
    }) }}
  {% else %}
    {{ govukInsetText({ text: "No data files have been processed yet. Visa applications are processed first, one file at a time." }) }}
  {% endif %}
{% endblock %}
