{% extends "layout.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "components/page-header.njk" import pageHeader %}
{% from "components/side-navigation.njk" import sideNavigation %}
{% from "components/record-tables.njk" import applicationsTable, guestsTable %}

{% block breadcrumbs %}
  {{ govukBreadcrumbs({ items: [
    { text: "Home", href: "/" },
    { text: "Accommodation", href: "/accommodations" },
    { text: accommodation.address }
  ] }) }}
{% endblock %}

{% block main_content %}
  {{ pageHeader({ caption: "Accommodation", title: accommodation.address }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-quarter">
      {% set base = "/accommodations/" + accommodation.id %}
      {{ sideNavigation({
        currentPath: currentPath,
        label: "Sections of this accommodation record",
        items: [
          { text: "Property details", href: base + "/details" },
          { text: "Sponsors (" + sponsors.length + ")", href: base + "/sponsors" },
          { text: "Applications (" + applications.length + ")", href: base + "/applications" },
          { text: "Guests (" + guests.length + ")", href: base + "/guests" }
        ]
      }) }}
    </div>

    <div class="govuk-grid-column-three-quarters">
      {% if section == "details" %}
      <h2 class="govuk-heading-l" id="details">Property details</h2>
      {{ govukSummaryList({
        card: { title: { text: "Address", headingLevel: 3 } },
        rows: [
          { key: { text: "Address" }, value: { text: accommodation.address or "Not given" } },
          { key: { text: "Postcode" }, value: { text: accommodation.postcode or "Not given" } },
          { key: { text: "Local authority" }, value: { text: accommodation.council or "No local authority named" } }
        ]
      }) }}
      {% endif %}

      {% if section == "sponsors" %}

      <h2 class="govuk-heading-l" id="sponsors">Sponsors</h2>
      {% if sponsors.length %}
        <ul class="govuk-list">
          {% for s in sponsors %}
            <li><a class="govuk-link" href="/sponsors/{{ s.id }}">{{ s.given_name }} {{ s.family_name }}</a></li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="govuk-body">No sponsors linked to this address.</p>
      {% endif %}
      {% endif %}

      {% if section == "applications" %}

      <h2 class="govuk-heading-l" id="applications">Applications</h2>
      {{ applicationsTable(applications, "Applications naming this address", { showSponsor: true }) }}
      {% endif %}

      {% if section == "guests" %}

      <h2 class="govuk-heading-l" id="guests">Guests</h2>
      {{ guestsTable(guests, "Guests heading to this address") }}
      {% endif %}
    </div>
  </div>
{% endblock %}
