{#
  In-page contents for detail pages. Wraps MOJ side navigation with a heading
  and the app-side-navigation styles (blue rule, sticky, scroll tracking).
  Usage:
    {{ sideNavigation({
      title: "On this page",
      label: "Sections of this application",
      items: [{ text: "Application", href: "#application" }, ...]
    }) }}
  The first item is marked active unless an item sets active itself.
#}
{% from "moj/components/side-navigation/macro.njk" import mojSideNavigation %}

{% macro sideNavigation(params) %}
  {% set hasActive = false %}
  {% for item in params.items %}{% if item.active %}{% set hasActive = true %}{% endif %}{% endfor %}
  {% set items = [] %}
  {% for item in params.items %}
    {% set items = (items.push({
      text: item.text,
      href: item.href,
      active: item.active or (not hasActive and loop.first)
    }), items) %}
  {% endfor %}
  <div class="app-side-navigation">
    <h2 class="govuk-heading-s app-side-navigation__title">{{ params.title or "On this page" }}</h2>
    {{ mojSideNavigation({
      label: params.label or params.title or "On this page",
      items: items
    }) }}
  </div>
{% endmacro %}
