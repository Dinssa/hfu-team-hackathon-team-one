{#
  MOJ filter panel inside a GET form, for list pages.
  Usage:
    {% call filterLayout({ action: "/applications", selectedFilters: selectedFilters, filters: filters }) %}
      ... the list or table ...
    {% endcall %}

  `filters` is a list of controls:
    { type: "text", name, label, value, hint? }
    { type: "checkboxes", name, legend, items: [{ value, text, checked }] }
    { type: "select", name, label, value, options: ["A", "B"], emptyText?: "All local authorities", autocomplete?: true }
    (autocomplete: true turns a long select into a type-ahead; leave it off for short lists)
#}
{% from "moj/components/filter/macro.njk" import mojFilter %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% macro filterLayout(params) %}
  {% set optionsHtml %}
    {% for f in params.filters %}
      {% if f.type == "text" %}
        {{ govukInput({
          id: "filter-" + f.name,
          name: f.name,
          value: f.value,
          label: { text: f.label, classes: "govuk-label--s" },
          hint: { text: f.hint } if f.hint else undefined
        }) }}
      {% elif f.type == "select" %}
        {% set items = [{ value: "", text: f.emptyText or "All", selected: not f.value }] %}
        {% for option in f.options %}
          {% set items = (items.push({ value: option, text: option, selected: f.value == option }), items) %}
        {% endfor %}
        {{ govukSelect({
          id: "filter-" + f.name,
          name: f.name,
          label: { text: f.label, classes: "govuk-label--s" },
          items: items,
          attributes: { "data-module": "app-autocomplete", "data-placeholder": f.placeholder or "Start typing or select one" } if f.autocomplete else {}
        }) }}
      {% elif f.type == "checkboxes" %}
        {{ govukCheckboxes({
          idPrefix: "filter-" + f.name,
          name: f.name,
          classes: "govuk-checkboxes--small",
          fieldset: { legend: { text: f.legend, classes: "govuk-fieldset__legend--s" } },
          items: f.items
        }) }}
      {% endif %}
    {% endfor %}
  {% endset %}

  <div class="moj-filter-layout">
    <div class="moj-filter-layout__filter">
      <form method="get" action="{{ params.action }}" novalidate>
        {{ mojFilter({
          heading: { text: "Filter" },
          selectedFilters: params.selectedFilters,
          submit: { text: "Apply filters" },
          optionsHtml: optionsHtml
        }) }}
      </form>
    </div>
    <div class="moj-filter-layout__content">
      <div class="moj-action-bar">
        <div class="moj-action-bar__filter"></div>
      </div>
      {{ caller() }}
    </div>
  </div>
{% endmacro %}
