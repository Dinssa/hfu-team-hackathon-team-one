{% extends "layout.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "components/page-header.njk" import pageHeader %}
{% from "components/side-navigation.njk" import sideNavigation %}

{% block breadcrumbs %}
  {{ govukBreadcrumbs({ items: [
    { text: "Home", href: "/" },
    { text: "Visa applications", href: "/applications" },
    { text: "Application " + (application.uan or application.submission_guid) }
  ] }) }}
{% endblock %}

{% block main_content %}
  {{ pageHeader({
    caption: "Visa application",
    title: lead.given_name + " " + lead.family_name,
    statusLabel: "Visa status",
    status: application.visa_status
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-quarter">
      {% set base = "/applications/" + application.id %}
      {{ sideNavigation({
        currentPath: currentPath,
        label: "Sections of this application",
        items: [
          { text: "Application", href: base + "/application" },
          { text: "Sponsor and accommodation", href: base + "/sponsor-and-accommodation" },
          { text: "Guests (" + guests.length + ")", href: base + "/guests" },
          { text: "Submitted answers", href: base + "/answers" },
          { text: "Raw submission", href: base + "/raw-submission" }
        ]
      }) }}
    </div>

    <div class="govuk-grid-column-three-quarters">
      {% if section == "application" %}
      <h2 class="govuk-heading-l" id="application">Application</h2>
      {{ govukSummaryList({
        card: { title: { text: "Reference details", headingLevel: 3 } },
        rows: [
          { key: { text: "UAN" }, value: { text: application.uan or "Not given" } },
          { key: { text: "GWF" }, value: { text: application.gwf or "Not given" } },
          { key: { text: "Submitted" }, value: { text: application.event_datetime | date } },
          { key: { text: "People on application" }, value: { text: guests.length } },
          { key: { text: "Case" }, value: { html: ('<a class="govuk-link" href="/cases/' + application.case_id + '">Case ' + application.case_id + '</a>') if application.case_id else "Not yet formed" } },
          { key: { text: "Source file" }, value: { text: application.source_file } }
        ]
      }) }}
      {% endif %}

      {% if section == "sponsor-and-accommodation" %}

      <h2 class="govuk-heading-l" id="sponsor-and-accommodation">Sponsor and accommodation</h2>
      {{ govukSummaryList({
        card: { title: { text: "Where the household is going", headingLevel: 3 } },
        rows: [
          { key: { text: "Sponsor" }, value: { html: ('<a class="govuk-link" href="/sponsors/' + application.sponsor_id + '">' + (application.sponsor_given_name + " " + application.sponsor_family_name) | e + '</a>') if application.sponsor_id else "Not given" } },
          { key: { text: "Accommodation" }, value: { html: ('<a class="govuk-link" href="/accommodations/' + application.accommodation_id + '">' + (application.accommodation_address + (", " + application.accommodation_postcode if application.accommodation_postcode and application.accommodation_postcode not in application.accommodation_address else "")) | e + '</a>') if application.accommodation_id else "No accommodation recorded yet" } },
          { key: { text: "Local authority" }, value: { text: application.council or "No local authority named" } },
          { key: { text: "Staying with sponsor" }, value: { text: application.staying_with_sponsor or "Not answered" } },
          { key: { text: "Host" }, value: { text: (application.host_given_name + " " + application.host_family_name) if application.host_given_name else "Same as sponsor" } }
        ]
      }) }}
      {% endif %}

      {% if section == "guests" %}

      <h2 class="govuk-heading-l" id="guests">Guests on this application</h2>
      {% for g in guests %}
        {{ govukSummaryList({
          card: { title: { text: g.given_name + " " + g.family_name, headingLevel: 3 }, actions: { items: [{ href: "/guests/" + g.id, text: "View guest", visuallyHiddenText: g.given_name + " " + g.family_name }] } },
          rows: [
            { key: { text: "Relationship" }, value: { text: g.relationship or "Not given" } },
            { key: { text: "Date of birth" }, value: { text: (g.date_of_birth | date("short")) or "Not given" } },
            { key: { text: "Sex" }, value: { text: g.sex or "Not given" } },
            { key: { text: "Nationality" }, value: { text: g.nationality or "Not given" } },
            { key: { text: "Passport number" }, value: { text: g.passport_number or "Not given" } }
          ]
        }) }}
      {% endfor %}
      {% endif %}

      {% if section == "answers" %}

      <h2 class="govuk-heading-l" id="answers">Submitted answers</h2>
      {% for person in people %}
        {% set rows = [] %}
        {% for answer in person.answers %}
          {% set rows = (rows.push({ key: { text: answer.key }, value: { text: answer.value or "Not answered" } }), rows) %}
        {% endfor %}
        {{ govukSummaryList({
          card: { title: { text: person.title, headingLevel: 3 } },
          rows: rows
        }) }}
      {% endfor %}
      {% endif %}

      {% if section == "raw-submission" %}

      {% if submission %}
        <h2 class="govuk-heading-l" id="raw-submission">Raw submission</h2>
        {{ govukDetails({
          summaryText: "Show the submission exactly as received",
          html: '<pre class="govuk-body-s app-pre">' + (submission | dump(2)) + '</pre>'
        }) }}
      {% endif %}
      {% endif %}
    </div>
  </div>
{% endblock %}
